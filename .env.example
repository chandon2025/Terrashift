# ========================================================
# 🌱 TerraShift - Environment Configuration (.env.example)
# NASA Space Apps Challenge - Bangladesh Agricultural Decision-Support
# ========================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# Client API Base URL (Frontend requests)
VITE_API_URL=http://localhost:3001/api

# NASA API Configuration (Official NASA Data Access)
# NASA POWER (Agroclimatology & satellite observation API)
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# NASA CMR (Common Metadata Repository API)
NASA_CMR_BASE_URL=https://cmr.earthdata.nasa.gov/search/granules.json

# Cache Time-To-Live in Minutes (Observations cache)
NASA_CACHE_TTL_MINUTES=60

# Optional NASA Earthdata Credentials (for enhanced rate limits if configured)
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_TOKEN=
